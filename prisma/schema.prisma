// Файл: prisma/schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// Тип категории: Доход или Расход
enum TransactionType {
  INCOME
  EXPENSE
}

model Wallet {
  id    String @id @default(cuid())
  name  String @unique // "ბარათი", "ნაღდი"
  balance Decimal @default(0.0)

  transactions Transaction[]
}

model Category {
  id    String @id @default(cuid())
  name  String @unique // "შეკეთება", "საწვავი", "საკომისიო Bolt"
  type  TransactionType

  transactions Transaction[]
}

model Transaction {
  id        String   @id @default(cuid())
  amount    Decimal
  notes     String?
  createdAt DateTime @default(now())

  // --- 🔥 НОВОЕ ПОЛЕ (ДЛЯ ПРЕДОТВРАЩЕНИЯ ДУБЛИКАТОВ) ---
  yandexTransactionId String? @unique

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  // 🔥 НОВЫЕ ПОЛЯ: Водитель (ОПЦИОНАЛЬНО, потому что не все транзакции от водителей)
  driverId  String?
  driver    Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([driverId]) // 🔥 НОВЫЙ ИНДЕКС
  @@index([yandexTransactionId])
}

model Driver {
  id              String         @id @default(cuid())
  yandexId        String?        @unique
  name            String
  phone           String?
  
  // 🔥🔥🔥 НОВЫЕ ПОЛЯ (Системные) 🔥🔥🔥
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt 

  transactions    Transaction[]
}